/* ============================================================
   TEAM PAGE — uses tokens from index.css
   ============================================================ */

.team-page { background: var(--c-bg); }

/* Reuse page-hero from other pages */
.page-hero {
  position: relative;
  min-height: 380px;
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  text-align: center;
  overflow: hidden;
}
.page-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(20,10,0,0.55) 0%, rgba(20,10,0,0.75) 100%),
    radial-gradient(ellipse at center, rgba(211,84,0,0.2) 0%, transparent 60%);
}
.page-hero-content {
  position: relative;
  z-index: 2;
  padding: 80px 22px 60px;
  max-width: 900px;
}
.page-hero .hero-title { margin-bottom: 14px; font-size: clamp(2.2rem, 5vw, 3.6rem); }
.page-hero .hero-subtitle { margin-bottom: 24px; }

.breadcrumbs {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 6px;
  padding: 8px 18px;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 999px;
  font-size: 13px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  backdrop-filter: blur(6px);
}
.breadcrumbs a { color: #ffd28a; }
.breadcrumbs a:hover { color: #fff; }
.breadcrumbs i { font-size: 10px; opacity: 0.7; }

/* ===== DIRECTORY ===== */
.team-directory { background: var(--c-bg); }

/* Controls */
.team-controls {
  margin: 40px auto 30px;
  padding: 22px 26px;
  background: #fff;
  border: 1px solid var(--c-line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
}

.search-container {
  display: flex;
  flex: 1;
  gap: 12px;
  max-width: 720px;
  flex-wrap: wrap;
}

.search-input-wrap,
.select-wrap {
  position: relative;
  flex: 1;
  min-width: 220px;
}
.search-input-wrap > i,
.select-wrap > i {
  position: absolute;
  left: 18px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--c-primary);
  font-size: 14px;
  pointer-events: none;
}

.search-input,
.filter-select {
  width: 100%;
  height: 46px;
  padding: 0 18px 0 44px;
  background: var(--c-bg-soft);
  border: 2px solid transparent;
  border-radius: 999px;
  font-size: 14px;
  font-family: inherit;
  color: var(--c-ink);
  outline: none;
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}
.filter-select {
  appearance: none;
  -webkit-appearance: none;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%23d35400' d='M6 8L0 0h12z'/></svg>");
  background-repeat: no-repeat;
  background-position: right 18px center;
  padding-right: 40px;
  cursor: pointer;
}
.search-input:focus,
.filter-select:focus {
  border-color: var(--c-primary);
  background: #fff;
  box-shadow: 0 0 0 4px rgba(211,84,0,0.12);
}

.results-info {
  font-size: 13px;
  color: var(--c-muted);
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* Grid */
.team-grid,
#teamGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 26px;
  margin-top: 10px;
}

/* Member card */
.member-card {
  position: relative;
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--c-line);
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}
.member-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md);
  border-color: var(--c-primary);
}

.member-photo {
  position: relative;
  width: 100%;
  margin: 0;
  background: linear-gradient(135deg, var(--c-bg-warm) 0%, var(--c-bg-soft) 100%);
  overflow: hidden;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.member-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 0;
  transition: transform 0.5s ease;
}
.member-card:hover .member-photo img { transform: scale(1.05); }

/* Default avatar (initials) */
.member-photo .default-avatar,
.default-avatar {
  width: 100%;
  height: 100%;
  border-radius: 0;
  background: var(--c-grad);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 56px;
  font-weight: 700;
  letter-spacing: 1px;
}

.member-info {
  padding: 20px 22px 22px;
  text-align: center;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-name {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 19px;
  font-weight: 700;
  color: var(--c-ink);
  margin-bottom: 6px;
  line-height: 1.25;
}

.member-post {
  font-size: 12px;
  color: var(--c-primary);
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  font-style: normal;
  margin-bottom: 10px;
}

.member-state {
  font-size: 13px;
  color: var(--c-ink-soft);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-bottom: 8px;
}
.member-state i { color: var(--c-primary); }

.member-contact {
  margin-top: auto;
  padding-top: 10px;
  font-size: 13px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
}
.member-contact i { color: var(--c-primary); width: auto; margin-right: 4px; }
.member-contact a { color: var(--c-primary); text-decoration: none; }
.member-contact a:hover { text-decoration: underline; }

/* Pagination */
.team-pagination,
#pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: 50px 0 0;
}
.team-pagination button,
#pagination button {
  min-width: 42px;
  height: 42px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: #fff;
  color: var(--c-ink-soft);
  border: 1px solid var(--c-line);
  border-radius: 999px;
  font-family: inherit;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}
.team-pagination button:hover:not(:disabled),
#pagination button:hover:not(:disabled) {
  border-color: var(--c-primary);
  color: var(--c-primary);
  transform: translateY(-1px);
}
.team-pagination button.active,
#pagination button.active {
  background: var(--c-grad);
  color: #fff;
  border-color: transparent;
}
.team-pagination button:disabled,
#pagination button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* States */
.loading {
  text-align: center;
  padding: 60px 20px;
  color: var(--c-primary);
}
.loading i { font-size: 2.4rem; }
.loading p { margin-top: 10px; color: var(--c-ink-soft); font-size: 14px; }

.no-results {
  text-align: center;
  padding: 60px 20px;
  color: var(--c-ink-soft);
}
.no-results i { font-size: 3rem; color: var(--c-primary); opacity: 0.5; margin-bottom: 16px; }
.no-results h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.5rem; margin-bottom: 8px; color: var(--c-ink); }

/* Light CTA band */
.cta-band-light { background: var(--c-bg-soft); border-top: 1px solid var(--c-line); }
.cta-band-light .section-inner.cta-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}
.cta-band-light .cta-actions { display: flex; flex-wrap: wrap; gap: 14px; }

/* Responsive */
@media (max-width: 768px) {
  .page-hero { background-attachment: scroll; min-height: 320px; }
  .page-hero-content { padding: 60px 18px 40px; }
  .team-controls { flex-direction: column; align-items: stretch; }
  .results-info { text-align: center; }
  .team-grid,
  #teamGrid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  .cta-band-light .section-inner.cta-inner { flex-direction: column; align-items: flex-start; }
}
